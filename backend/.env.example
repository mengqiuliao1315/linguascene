# 应用
APP_NAME=LinguaScene
ENV=development
# 生产必须改成随机长字符串
SECRET_KEY=dev-secret-key-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 账号策略：内部站点保持 false，不开放自助注册
ALLOW_PUBLIC_REGISTRATION=false

# 初始管理员（由 python -m app.seed 创建，部署后请立即改密码）
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@linguascene.app
ADMIN_PASSWORD=admin12345

# 数据库
DATABASE_URL=sqlite:///./linguascene.db
# 开发库可自动建表/补列。生产请设为 false，改跑：
#   py -3.12 -m alembic upgrade head
AUTO_CREATE_TABLES=true

# 缓存（小内存服务器用 memory 即可）
# redis 需要 `pip install redis`；连不上或没装时会回落到进程内缓存并打错误日志。
CACHE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# 文件存储
# s3 需要 `pip install boto3` 并填写桶名；否则回落到本地磁盘并打错误日志。
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
# S3_ENDPOINT_URL=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# AI：mock 无需 Key 即可跑通全流程；接真实模型把 AI_PROVIDER 改为 openai
AI_PROVIDER=mock
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_SMALL_MODEL=deepseek-chat
# 兜底模型的接入格式：openai / openai_responses / anthropic / gemini
AI_API_FORMAT=openai
AI_TIMEOUT_SECONDS=60
# 已不再单独挑选转写模型：模型通道会使用用户当前配置的模型名。
# 这个变量只作兼容保留，留空即可。
AI_STT_MODEL=

# 服务端本地语音识别（可选，但强烈建议开）：装了 faster-whisper 后，用户没接
# 模型 API（或那把 Key 失效）时由服务器自己识别——不需要任何 Key、不花钱，
# 也是内嵌 webview 里唯一能用的通道（那里的浏览器识别连不上服务）。
# 模型：tiny.en 快但认不准，base.en 平衡，small.en 最准（约 490MB，每句约 2.5s）。
# 重启服务时会后台把模型下到 backend/storage/whisper，下完才认得动；服务器不通
# 外网的话，请提前把模型目录放好，否则「本地识别」会一直不可用。
LOCAL_ASR=true
LOCAL_ASR_MODEL=small.en

# 启动时把场景开场白的朗读音频先合成好，第一次进对话就能立刻出声。
# 测试环境置 false，避免每个用例都去连语音服务。
SPEECH_PREWARM=true

# CORS（前端走同源代理时其实用不到，保留给直连场景）
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
